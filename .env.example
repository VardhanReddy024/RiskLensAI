# ==============================================================================
# RiskLens AI - Environment Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=INFO
BODY_LIMIT=50mb

# ------------------------------------------------------------------------------
# 2. Database & Persistent Store Provider
# Options: 'postgres' | 'firestore' | 'memory'
# ------------------------------------------------------------------------------
DATA_STORE_PROVIDER=firestore
DATABASE_URL=
REDIS_URL=
FIRESTORE_PROJECT_ID=risklens-ai-prod
GOOGLE_CLOUD_PROJECT=risklens-ai-prod

# ------------------------------------------------------------------------------
# 3. AI & Vector Engine Integrations
# ------------------------------------------------------------------------------
# Server-side Gemini API Key for Copilot & 8-Agent Orchestrator
GEMINI_API_KEY=

# Optional Qdrant Vector Engine for Hybrid Fraud Pattern Similarity
QDRANT_URL=
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. Security & Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# ------------------------------------------------------------------------------
# 5. Client (Vite) Public Configuration (Prefix with VITE_)
# ------------------------------------------------------------------------------
VITE_APP_ENV=production
VITE_APP_NAME=RiskLens AI
VITE_API_URL=
VITE_API_BASE_URL=
VITE_ENABLE_ANALYTICS=true

# Optional Firebase Web Client Configuration (if using Firebase Auth in browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
